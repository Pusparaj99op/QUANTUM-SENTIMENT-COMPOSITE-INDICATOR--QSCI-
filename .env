BINANCE_API_SECRET=9trLkyBGwSFr404IH6NcjUQwNcXIuOLw8tvUcOJoWkOq0i89qBuHaLQ2jwF1KcUU

# === TRADING CONFIGURATION ===
# Mode: "paper" for simulated trading, "backtest" for historical testing
TRADING_MODE=paper

# Starting balance for paper trading (USD)
INITIAL_BALANCE=10000

# Check interval in minutes (1, 5, 15, 30, 60)
CHECK_INTERVAL_MINUTES=1

# === OPTIONAL: NEWS API ===
# CryptoPanic API key (free tier: 1000 requests/day)
# Get from: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=05cd12aa86b6ed403e44b3e59ae5fb88830d52b1

# === OPTIONAL: ADVANCED SETTINGS ===
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timezone for log messages
TIMEZONE=UTC

# Maximum daily loss before stopping (percentage)
MAX_DAILY_LOSS_PCT=5

# Maximum drawdown before stopping (percentage)
MAX_DRAWDOWN_PCT=20
