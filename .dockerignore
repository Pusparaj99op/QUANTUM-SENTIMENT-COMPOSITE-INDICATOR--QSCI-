# Docker ignore file for QSCI Trading Bot
# Reduces build context size and build time

# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
qsci_venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Local data
data/
temp/
*.csv
*.json.bak

# Test files
tests/
test_*.py
*_test.py
.pytest_cache/
.coverage
htmlcov/

# Documentation
docs/
*.md
!README.md

# Rust build artifacts (not needed in production Python image)
hft_core/target/
*.rs

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Environment files (use Koyeb secrets instead)
.env
.env.local
.env.*.local

# Backup files
*.bak
*.backup

# Plots (generated during backtest)
plots/
*.png
*.jpg

# Large data files
*.parquet
*.pkl
*.pickle
