# QSCI Trading Bot - Environment Variables Template
# Copy to .env and fill in your values
# NEVER commit .env to version control!

# === TELEGRAM CONFIGURATION ===
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ123456789

# Channel ID (starts with -100 for channels)
# Use @getidsbot or forward a message to @userinfobot to get this
TELEGRAM_CHANNEL_ID=-1001234567890

# === MONGODB ATLAS ===
# Get from MongoDB Atlas Dashboard > Connect > Connect your application
# Replace <password> with your actual password
MONGODB_URI=mongodb+srv://qsci_bot:YOUR_PASSWORD@qsci-cluster.xxxxx.mongodb.net/qsci_trading?retryWrites=true&w=majority

# === BINANCE API ===
# Get from Binance > Profile > API Management
# Only READ permission required for paper trading!
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# === TRADING CONFIGURATION ===
# Mode: "paper" for simulated trading, "backtest" for historical testing
TRADING_MODE=paper

# Starting balance for paper trading (USD)
INITIAL_BALANCE=10000

# Check interval in minutes (1, 5, 15, 30, 60)
CHECK_INTERVAL_MINUTES=5

# === OPTIONAL: NEWS API ===
# CryptoPanic API key (free tier: 1000 requests/day)
# Get from: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key

# === OPTIONAL: ADVANCED SETTINGS ===
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timezone for log messages
TIMEZONE=UTC

# Maximum daily loss before stopping (percentage)
MAX_DAILY_LOSS_PCT=5

# Maximum drawdown before stopping (percentage)
MAX_DRAWDOWN_PCT=20
